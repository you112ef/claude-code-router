{
  "name": "claude-code-router-android",
  "version": "1.0.0",
  "description": "Android app for Claude Code Router with local AI model",
  "author": "Claude Code Router Team",
  "license": "MIT",
  "keywords": [
    "react-native",
    "android",
    "claude",
    "ai",
    "local-model",
    "llama",
    "router"
  ],
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "clean": "cd android && ./gradlew clean",
    "build:js": "node scripts/build-nodejs.js",
    "postinstall": "node scripts/build-nodejs.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "prepare-release": "npm run clean && npm run build:js && npm run validate && npm run android:release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.6",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/stack": "^6.3.29",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.9.0",
    "react-native-gesture-handler": "^2.15.0",
    "react-native-vector-icons": "^10.0.3",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "^3.7.2",
    "react-native-svg": "^15.1.0",
    "nodejs-mobile-react-native": "^0.6.1",
    "react-native-fs": "^2.20.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-modal": "^13.0.1",
    "react-native-mmkv": "^2.12.0",
    "react-native-device-info": "^10.13.0",
    "react-native-permissions": "^4.1.5",
    "@react-native-community/netinfo": "^11.3.1",
    "react-native-webview": "^13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@testing-library/react-native": "^12.4.0",
    "@testing-library/jest-native": "^5.4.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "0.73.10",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}